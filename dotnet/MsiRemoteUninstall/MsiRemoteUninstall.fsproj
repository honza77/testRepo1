<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MsiRemoteUninstall</AssemblyName>
    <RootNamespace>MsiRemoteUninstall</RootNamespace>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Remote management APIs used here (WinRM client, WMI/DCOM) are Windows-only at runtime -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="Credentials.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="Transport.fs" />
    <Compile Include="PsRemotingTransport.fs" />
    <Compile Include="WmiTransport.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
